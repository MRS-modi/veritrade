# Optional: needed to enable WalletConnect as a connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: custom public RPC endpoint. The app uses the public wagmi default if blank.
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=

# Add these when your contracts and tokens have been deployed and verified.
NEXT_PUBLIC_ORDERBOOK_ADDRESS=
NEXT_PUBLIC_TEST_USDC_ADDRESS=
NEXT_PUBLIC_TEST_USDC_FAUCET_ADDRESS=
